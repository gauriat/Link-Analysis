# Copy this file to .env and fill in your key. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY="AI_KEY_HERE"

# Check https://aistudio.google.com for the Flash model available on your free tier
GEMINI_MODEL=gemini-3.5-flash

# LLM call limits
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=12000
LLM_TEMPERATURE=0.3
# Thinking effort: minimal | low | medium | high (empty = model default). Lower is faster and cheaper.
LLM_THINKING_LEVEL=low

# Website fetching
REQUEST_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=2000000
MAX_CONTENT_CHARS=24000

# Result cache (seconds); 0 disables caching
CACHE_TTL_SECONDS=3600
